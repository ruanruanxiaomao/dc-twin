# Generated artifacts are rebuilt by: dc run --scope full / python run.py
out/*
!out/CURRENT_STATUS.md
!out/renders/
out/renders/*
!out/renders/.gitkeep

# Scenario runs and local state
runs/
# 玩家存档（含快照与事件流路径，机器相关；saves/meta.json 也是本机进度）
saves/
tests/_tmp_spec/
*.bak
data/config.bak.json

# 一次运行 = 一个产物包（scripts/run_bundle.py 生成，体积大、可重建）
artifacts/

# 扩仓变体的派生数据（scripts/build_variant.py 可重建；spec 本身要提交）
data/scene_variant.json
data/areas_variant.json
out/variant/
# 实验产物（check_reorder 等压力实验）：不许与产线 runs/ 混放
out/exp/

# Python / tooling
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Blender / OS / logs
*.blend1
*.blend2
*.log
.DS_Store
