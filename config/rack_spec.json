{
  "schema_version": "1.0",
  "kind": "rack_spec",
  "note": "货架按【存取机理】分型，不按自动化分型（资料审校原则：货架参考:4）。这是 R0 骨架，先落 D8 的 9 类（横梁基线 + 8 类高密度/动态流动）；回转/VCM/VLM/阁楼/悬臂/搁板留到后续。所有数值带 source/level：资料只给定性描述的地方标 gap，不臆造。",
  "meta": {
    "sources": [
      {
        "param": "geometry（clearW/D/H、struct、gap）",
        "value": "1.1/1.1/1.3, 0.07/0.05/0.1, gap 0.1",
        "source": "评价公式说明.html:54-67 + config/layout_spec.json:100-107 defaults.rack",
        "level": "assumption"
      },
      {
        "param": "n_depth 与库存顺序",
        "value": "double_deep=2 / drive_in=aisle_depth",
        "source": "仓储货架技术参考:11（双深后位受前位阻挡；驶入式单端 LIFO）",
        "level": "typical"
      },
      {
        "param": "open_close_s / shuttle_change_aisle_s",
        "value": "20 / 30",
        "source": "资料未给数值（§5.3 缺口），取工程经验的保守端",
        "level": "gap"
      },
      {
        "param": "geometry clearW/clearD（托盘类）",
        "value": "0.9 / 1.3 m",
        "source": "由设计托盘 EUR 1200x800 推导；工具默认 1.1/1.1 装不下 1200 长托盘",
        "level": "assumption"
      }
    ]
  },
  "defaults": {
    "geometry": {
      "clearW": 0.9,
      "clearD": 1.3,
      "clearH": 1.3,
      "structW": 0.07,
      "structD": 0.05,
      "structH": 0.1,
      "gap": 0.1
    },
    "levels": 4,
    "level_height": 1.5,
    "top_height": 6.0
  },
  "effective_capacity_rules": {
    "deduct": [
      "deep_tail_qty",
      "batch_no_mix",
      "frozen_aisle",
      "maintenance_out",
      "safety_disabled"
    ],
    "formula": "effective = nominal * (1 - tail_loss) * batch_mix_factor - frozen - maintenance - disabled",
    "note": "名义货位 ≠ 有效货位（货架参考:11）。尾量/批次不可混放/冻结通道/维修停用/安全禁用都要扣，扣项单独可审计，不许在实现里折成一个拍出来的系数。"
  },
