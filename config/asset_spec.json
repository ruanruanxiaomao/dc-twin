{
  "schema_version": "1.0",
  "kind": "asset_spec",
  "note": "3D 资产目录（R8）。键与 rack_spec.types / equipment_spec.types 一一对应，外观与行为共用一个 mechanism_key，杜绝『看着是驶入式、跑起来是横梁式』。source 只有两种写法：glb:<节点名>（须在 GLB 实测清单内）或 procedural:<函数名>（模块内的真实函数）。默认不接入主链：asset_spec 不被 build_dc 读取时，产出与现状逐字节一致。",
  "default_off": true,
  "meta": {
    "provenance": {
      "glb": "assets/cargotwin_assets.glb",
      "license": "MIT (cargoTwin)",
      "measured": {
        "magic": "glTF",
        "version": 2,
        "bytes": 700396,
        "nodes": 164,
        "meshes": 126,
        "asset_roots": 38
      },
      "method": "只读解析 GLB 的 JSON chunk（struct.unpack('<II', d[12:20]) → json.loads(d[20:20+jlen])），按 '__' 后缀去重取 asset_ 根。",
      "wired_at_r81": 5,
      "idle_masters": 33
    },
    "authority": {
      "rack_behavior": "config/rack_spec.json#types",
      "equipment_behavior": "config/equipment_spec.json#types",
      "footprint_geometry": "config/rack_spec.json#types[*].geometry",
      "layout": "config/layout_spec.json"
    },
    "mechanism_rule": "rack_assets 的键集合 == rack_spec.types 的键集合；equipment_assets 的键集合 == equipment_spec.types 的键集合。双向相等，多一个或少一个都判红。",
    "status_enum": [
      "existing",
      "idle_master",
      "variant",
      "new",
      "gap",
      "deferred"
    ],
    "status_meaning": {
      "existing": "母版/程序化函数已接进 build_dc 派发链，外观就是它；须给 implemented_in。货架是否真的按机理建，取决于布局是否声明 rack_type",
      "idle_master": "GLB 母版存在但尚未接入（闲置母版），R8.2 接",
      "variant": "复用同一母版 + 参数化差异（门架/货叉/高度），尚未实现",
      "new": "需新增程序化函数，尚未实现",
      "gap": "无母版且资料数值不足，只做外观或先挂着"
    },
    "footprint_rule": "货架 palette 模块 = 3 个货格宽 × depth_positions 个货格深；由 rack_spec.geometry 的 clearW/clearD + structW/structD 复算，asset_spec 里写的 footprint_m 必须与之相等（浮点容差 1e-6），否则判红。方案书 §16.4 示例写的 1.2 m 深是示意值，真实值由 EUR 1200×800 推出的 clearD 1.3 + structD 0.05 = 1.35 m 决定，以 geometry 为准。"
  },
  "render_paths": {
    "blender": {
      "generator": "scripts/build_dc.py",
      "asset_glb": "assets/cargotwin_assets.glb",
      "export": "scripts/export_glb.py"
    },
    "canvas2d": {
      "editor": "submission/editor.js",
      "preview": "submission/twin3d.js",
      "demo": "demo/app.js"
    }
  },
  "rack_module": {
    "bays": 3,
    "axis_note": "footprint_m = [bays × (clearW + structW), depth_positions × (clearD + structD)]"
  },
