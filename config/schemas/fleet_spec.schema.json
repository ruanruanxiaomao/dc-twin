{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fleet_spec",
  "type": "object",
  "required": ["schema_version", "models", "deployment"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "models": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "length", "width", "speed_mps", "battery_kwh"],
        "properties": {"length": {"type": "number", "exclusiveMinimum": 0},
                       "width": {"type": "number", "exclusiveMinimum": 0},
                       "speed_mps": {"type": "number", "exclusiveMinimum": 0},
                       "battery_kwh": {"type": "number", "exclusiveMinimum": 0}}
      }
    },
    "deployment": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["warehouse", "model", "count"],
        "properties": {"count": {"type": "integer", "minimum": 1}}
      }
    },
    "battery": {"type": "object", "required": ["warning_pct", "critical_pct", "charge_to_pct", "reserve_pct"]}
  }
}
