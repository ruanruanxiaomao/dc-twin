{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "unit_load_spec (G3)",
  "type": "object",
  "required": ["schema_version", "kind", "enabled", "module_mm", "pallet_standards",
               "tote_classes", "load_rating_order", "identification"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "unit_load_spec"},
    "enabled": {"type": "boolean", "description": "默认关闭：关闭时不进事件流，金标准字节不变"},
    "note": {"type": "string"},
    "meta": {"type": "object"},
    "module_mm": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"type": "integer", "minimum": 100, "maximum": 2000}
    },
    "pallet_standards": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["l", "w", "dynamic_kg", "static_kg", "rack_kg", "source", "level"],
        "properties": {
          "l": {"type": "integer", "minimum": 400, "maximum": 3000},
          "w": {"type": "integer", "minimum": 400, "maximum": 3000},
          "h": {"type": "integer", "minimum": 50, "maximum": 500},
          "dynamic_kg": {"type": "number", "exclusiveMinimum": 0},
          "static_kg": {"type": "number", "exclusiveMinimum": 0},
          "rack_kg": {"type": "number", "exclusiveMinimum": 0},
          "tare_kg": {"type": "number", "minimum": 0},
          "source": {"type": "string"},
          "level": {"enum": ["standard", "typical", "assumption", "placeholder", "gap"]}
        }
      }
    },
    "tote_classes": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["l", "w", "h", "dynamic_kg", "source", "level"],
        "properties": {
          "l": {"type": "integer", "minimum": 100, "maximum": 1200},
          "w": {"type": "integer", "minimum": 100, "maximum": 1200},
          "h": {"type": "integer", "minimum": 50, "maximum": 1000},
          "volume_l": {"type": "number", "exclusiveMinimum": 0},
          "dynamic_kg": {"type": "number", "exclusiveMinimum": 0},
          "stack_kg": {"type": "number", "exclusiveMinimum": 0},
          "tare_kg": {"type": "number", "minimum": 0},
          "per_pallet_layer": {"type": "integer", "minimum": 1},
          "source": {"type": "string"},
          "level": {"enum": ["standard", "typical", "assumption", "placeholder", "gap"]}
        }
      }
    },
    "load_rating_order": {
      "type": "array", "minItems": 1,
      "items": {"enum": ["rack", "dynamic", "static", "stack"]},
      "description": "上架时的荷载校核顺序；rack 必须在前（最严苛）"
    },
    "identification": {
      "type": "object",
      "required": ["gate_read_rate_min", "sscc_digits", "ai_fields"],
      "properties": {
        "gate_read_rate_min": {"type": "number", "minimum": 0.9, "maximum": 1.0},
        "barcode_X_mm": {"type": "number", "exclusiveMinimum": 0},
        "barcode_X_dynamic_mm": {"type": "number", "exclusiveMinimum": 0},
        "pcs_min": {"type": "number", "minimum": 0, "maximum": 4},
        "red_invalid": {"type": "boolean"},
        "rfid_bands": {"type": "object"},
        "sscc_digits": {"type": "integer", "minimum": 8, "maximum": 32},
        "container_iso6346_digits": {"type": "integer", "minimum": 4, "maximum": 32},
        "ai_fields": {"type": "object", "additionalProperties": {"type": "string"}},
        "source": {"type": "string"},
        "level": {"enum": ["standard", "typical", "assumption", "placeholder", "gap"]}
      }
    },
    "compatibility_rules": {
      "type": "object",
      "properties": {
        "rack_rating_is_strictest": {"type": "boolean"},
        "check_outer_envelope": {"type": "boolean"},
        "envelope_note": {"type": "string"},
        "equipment_payload_margin": {"type": "number", "minimum": 1.0},
        "level": {"enum": ["standard", "typical", "assumption", "placeholder", "gap"]}
      }
    }
  }
}
