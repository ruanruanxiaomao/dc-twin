{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "layout_spec",
  "type": "object",
  "required": ["schema_version", "site", "defaults", "warehouses"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "site": {
      "type": "object",
      "required": ["id", "size"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "units": {"const": "m"},
        "size": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}, "minItems": 3, "maxItems": 3},
        "seed": {"type": "integer"}
      }
    },
    "defaults": {
      "type": "object",
      "required": ["agv", "rack", "ap", "grid"],
      "properties": {
        "agv": {"type": "object", "required": ["length", "width", "speed", "safety_margin"]},
        "rack": {"type": "object", "required": ["length", "depth", "levels", "level_height", "top_height"]},
        "ap": {"type": "object", "required": ["offset", "min_clearance", "spawn_sep"]},
        "grid": {"type": "object", "required": ["cell_size"]}
      }
    },
    "warehouses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "origin", "size", "racks"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "origin": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
          "size": {"type": "object", "required": ["width", "depth", "height"]},
          "racks": {"type": "array", "minItems": 1},
          "spawns": {"type": "object"}
        }
      }
    }
  }
}
