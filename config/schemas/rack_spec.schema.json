{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "rack_spec (G1)",
  "type": "object",
  "required": ["schema_version", "kind", "defaults", "types", "effective_capacity_rules"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "rack_spec"},
    "note": {"type": "string"},
    "meta": {"type": "object"},
    "defaults": {
      "type": "object",
      "required": ["geometry", "levels", "level_height"],
      "properties": {
        "geometry": {"$ref": "#/definitions/geometry"},
        "levels": {"type": "integer", "minimum": 1, "maximum": 40},
        "level_height": {"type": "number", "exclusiveMinimum": 0.3},
        "top_height": {"type": "number", "exclusiveMinimum": 0.5}
      }
    },
    "effective_capacity_rules": {
      "type": "object",
      "required": ["deduct", "formula"],
      "properties": {
        "deduct": {"type": "array", "items": {"type": "string"}},
        "formula": {"type": "string"},
        "note": {"type": "string"}
      }
    },
    "types": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["family", "storage_unit", "access_mechanism", "n_depth",
                     "inventory_order", "fifo_forced", "equipment_allowed", "source", "level"],
        "properties": {
          "name": {"type": "string"},
          "family": {"enum": ["direct_access", "high_density", "dynamic_flow",
                              "carousel", "vertical_lift", "platform", "cantilever", "shelving"]},
          "storage_unit": {"enum": ["pallet", "tote", "piece", "long_material", "container"]},
          "access_mechanism": {"type": "string"},
          "n_depth": {
            "oneOf": [
              {"type": "integer", "minimum": 1, "maximum": 100},
              {"enum": ["aisle_depth"]}
            ],
            "description": "B5：不再写死 1。整数=固定深位；aisle_depth=驶入/驶出/重力/压入的整巷道深度"
          },
          "aisle_depth_positions": {
            "type": "array", "minItems": 2, "maxItems": 2,
            "items": {"type": "integer", "minimum": 1, "maximum": 200}
          },
          "inventory_order": {"enum": ["FIFO", "LIFO", "system", "batch_paired",
                                       "single_end_LIFO_double_end_FIFO"]},
          "fifo_forced": {"type": "boolean", "description": "物理强制（结构决定）还是仅系统约定"},
          "rear_blocked_by_front": {"type": "boolean"},
          "single_end": {"type": "boolean"},
          "double_end": {"type": "boolean"},
          "reshuffle_rate": {"type": "number", "minimum": 0, "maximum": 1},
          "shuttle_change_aisle_s": {"type": "number", "minimum": 0},
          "open_close_s": {"type": "number", "minimum": 0},
          "simultaneous_aisles": {"type": "integer", "minimum": 1},
          "interlock": {"type": "boolean"},
          "selectivity": {"enum": ["high", "medium", "low"]},
          "density": {"enum": ["low", "medium", "medium_high", "high", "very_high"]},
          "equipment_allowed": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "geometry": {"$ref": "#/definitions/geometry"},
          "source": {"type": "string"},
          "level": {"enum": ["standard", "typical", "assumption", "placeholder", "gap"]},
          "gap_fields": {"type": "array", "items": {"type": "string"}},
          "note": {"type": "string"}
        }
      }
    }
  },
  "definitions": {
    "geometry": {
      "type": "object",
      "required": ["clearW", "clearD", "clearH", "structW", "structD", "structH", "gap"],
      "additionalProperties": false,
      "properties": {
        "clearW": {"type": "number", "exclusiveMinimum": 0.1},
        "clearD": {"type": "number", "exclusiveMinimum": 0.1},
        "clearH": {"type": "number", "exclusiveMinimum": 0.1},
        "structW": {"type": "number", "minimum": 0},
        "structD": {"type": "number", "minimum": 0},
        "structH": {"type": "number", "minimum": 0},
        "gap": {"type": "number", "minimum": 0}
      }
    }
  }
}
