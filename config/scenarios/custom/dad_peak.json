{
  "schema_version": "1.0",
  "id": "dad_peak",
  "name": "高峰自定义场景（示例）",
  "layout_spec": "../layout_spec.json",
  "fleet_spec": "../fleet_spec.json",
  "demand_spec": "../demand_spec.json",
  "seed": 20261109,
  "simulation": {
    "warmup_s": 0,
    "duration_s": 3600,
    "dt_s": 0.1,
    "fps": 8,
    "max_wall_clock_s": 900
  },
  "overrides": {
    "demand.orders.per_hour": 120,
    "fleet.size": 30,
    "demand.orders.mix": {
      "INBOUND": 0.2,
      "OUTBOUND": 0.25,
      "PICK": 0.25,
      "REPLENISH": 0.15,
      "TRANSFER": 0.15
    }
  },
  "disruptions": [
    {
      "type": "dock_blocked",
      "dock": "W-OU-02",
      "start_s": 100,
      "duration_s": 300
    }
  ],
  "assertions": [
    {
      "metric": "orders_completed",
      "op": ">",
      "value": 0
    },
    {
      "metric": "strict_collisions",
      "op": "==",
      "value": 0
    }
  ],
  "outputs": [
    "sim_kpi.json",
    "sim_events.jsonl",
    "pnl.json"
  ]
}
