{
  "schema_version": "1.0",
  "id": "peak",
  "name": "高峰：90 单每小时 / 4 小时 / 28 台 AGV",
  "layout_spec": "../layout_spec.json",
  "fleet_spec": "../fleet_spec.json",
  "demand_spec": "../demand_spec.json",
  "seed": 20261106,
  "simulation": {"warmup_s": 0, "duration_s": 14400, "dt_s": 0.1, "fps": 8, "max_wall_clock_s": 900},
  "overrides": {"demand.orders.per_hour": 90, "fleet.size": 28},
  "disruptions": [],
  "assertions": [
    {"metric": "throughput_orders_per_h", "op": ">=", "value": "1.5*baseline:throughput_orders_per_h"},
    {"metric": "utilization", "op": ">=", "value": "1.4*baseline:utilization"},
    {"metric": "orders_generated", "op": "==", "value": 360}
  ],
  "outputs": ["kpi.json", "assertions.json", "manifest.json", "report.md"]
}
