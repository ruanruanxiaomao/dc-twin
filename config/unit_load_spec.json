      {"param": "gate_read_rate_min", "value": 0.995, "source": "标识与识别参考 F2:455（通道门识读率验收）", "level": "typical"},
      {"param": "barcode_X_mm", "value": 0.495, "source": "F2:400-403", "level": "standard"}
    ]
  },
