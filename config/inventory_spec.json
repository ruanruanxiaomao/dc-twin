{
  "schema_version": "1.0",
  "kind": "inventory_spec",
  "note": "改这里不改 Python。库位/数量现算于 data/*.json；本文件只定义行为与费率。数值为演示值（placeholder），与 cost_spec 的 prices_source=demo 同口径。",
  "reorder": {
    "policy": "reorder_point",
    "safety_stock_factor": 1.5,
    "reorder_point_factor": 2.0,
    "replenish_qty": "to_max",
    "reorder_check": "on_stock_change"
  },
  "holding": {
    "holding_rate_per_year": 0.24,
    "accrual": "sim_hour"
  },
  "stockout": {
    "penalty_per_unit": 8.0,
    "policy": "fail_order",
    "partial_fill": true
  },
  "shrink": {
    "rate": 0.0
  },
  "pick_face": {
    "enabled": true,
    "min_fill_ratio": 0.3,
    "refill_from": "reserve",
    "max_per_warehouse": 24,
    "fill_ratio_of_reserve": 0.3
  },
  "stock_policy": {
    "base_qty": { "A": 48, "B": 24, "C": 8 },
    "overflow_multiplier": 0.5,
    "qty_is_integer": true
  },
  "expiry": {
    "enabled": true,
    "policy": "FEFO",
    "shelf_life_s_by_class": { "A": 7200, "B": 14400, "C": 28800 },
    "initial_lot_life_fraction": [[0.02, 0.35], [0.40, 0.75], [0.80, 1.0]],
    "aging_every_n_locations": 3,
    "max_lots_per_location": 3,
    "waste_posting": "none",
    "note": "演示压缩：真实效期按天/月，这里按仿真秒。baseline horizon=3600s，若按 30 天计效期，一个批次都不会过期，P6b 的核心行为在验证窗口里不可观测（等于死代码）。故 A/B/C 取 2h/4h/8h，与 cost_spec 的 demo 价同性质。initial_lot_life_fraction 是'期初这批货还剩多少寿命'的区间，按库位序号确定性取值；aging_every_n_locations 只让每 N 个库位有一个临期货，避免整仓同时报废（那不叫效期管理，叫一次性事故）。waste_posting=none 的理由见 ADR-GAME-10：采购从未进 P&L，把报废记成费用会凭空造出一笔从未支付的成本。"
  }
}
