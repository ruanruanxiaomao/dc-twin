{"analytic":[{"key":"orders_generated","value":360,"unit":"orders","definition":"本次场景生成的订单数","formula":"N = Poisson(per_hour/3600 * duration_s) samples <= duration_s","source":"runs/<id>/events.jsonl"},{"key":"throughput_orders_per_h","value":45.0,"unit":"orders/h","definition":"解析模型下的稳定吞吐（到达率与车队容量取小）","formula":"min(lambda, c/S) * 3600; lambda=per_hour/3600, S=avg_path/speed+2*dwell","source":"analytic M/M/c (scenario layer, NOT per-vehicle A*)"},{"key":"throughput_lines_per_h","value":131.375,"unit":"lines/h","definition":"按平均订单行数折算的行吞吐","formula":"throughput_orders_per_h * (sum(qty)/N)","source":"analytic M/M/c (scenario layer, NOT per-vehicle A*)"},{"key":"on_time_rate","value":1.0,"unit":"ratio","definition":"主链 demo 窗口中 t_end <= deadline 的订单比例","formula":"count(t_end <= deadline) / orders","source":"out/path_metrics.json + out/traffic_report.json (main chain, 21 orders)"},{"key":"max_tardiness_s","value":0.0,"unit":"s","definition":"主链 demo 窗口最大超期","formula":"max(0, t_end - deadline)","source":"out/path_metrics.json + out/traffic_report.json (main chain, 21 orders)"},{"key":"avg_wait_s","value":0.0,"unit":"s","definition":"解析模型平均排队等待（Erlang-C）","formula":"Wq = P_wait * S / (c - a), a = lambda*S","source":"analytic M/M/c (scenario layer, NOT per-vehicle A*)"},{"key":"utilization","value":0.0357,"unit":"ratio","definition":"车队利用率","formula":"rho = lambda*S/c","source":"analytic M/M/c (scenario layer, NOT per-vehicle A*)"},{"key":"idle_rate","value":0.9643,"unit":"ratio","definition":"车队空闲率","formula":"1 - utilization","source":"analytic M/M/c (scenario layer, NOT per-vehicle A*)"},{"key":"energy_per_order_kwh","value":0.068074,"unit":"kWh/order","definition":"每单估算能耗","formula":"avg_path_m * consumption_kwh_per_m + idle_kw * S/3600","source":"analytic M/M/c (scenario layer, NOT per-vehicle A*)"},{"key":"dock_utilization","value":0.037,"unit":"ratio","definition":"月台门占用率","formula":"dock_orders * service_time_s / (doors * duration_s)","source":"analytic M/M/c (scenario layer, NOT per-vehicle A*)"},{"key":"max_dock_queue","value":0,"unit":"vehicles","definition":"最大月台排队长度（解析队列 + 封锁改派）","formula":"round(Lq) + (1 if reassigned>0 else 0)","source":"analytic M/M/c (scenario layer, NOT per-vehicle A*)"},{"key":"station_utilization","value":0.0201,"unit":"ratio","definition":"打包/分拣站占用率","formula":"pick_orders * station_service_s / (stations * duration_s)","source":"analytic M/M/c (scenario layer, NOT per-vehicle A*)"},{"key":"congestion_index","value":0.0,"unit":"s/m","definition":"单位路径长度的等待时间","formula":"avg_wait_s / avg_path_m","source":"analytic M/M/c (scenario layer, NOT per-vehicle A*)"},{"key":"strict_collisions","value":0,"unit":"count","definition":"主链严格口径采样点中心距 < 2*AGV_RADIUS 的次数","formula":"sum over t of pairs with dist < 2R (dt=0.05 s)","source":"out/path_metrics.json + out/traffic_report.json (main chain, 21 orders)"},{"key":"path_to_euclid_ratio","value":1.099,"unit":"ratio","definition":"主链路径长 / 任务点折线直线距离","formula":"total_path_m / sum(|p_i -> p_i+1|)","source":"out/path_metrics.json + out/traffic_report.json (main chain, 21 orders)"},{"key":"predicted_on_time_rate","value":0.0,"unit":"ratio","definition":"解析模型预计准时率（指数尾近似，仅作趋势参考）","formula":"exp(-max(0, deadline_P2 - S)/(Wq+S))","source":"analytic M/M/c (scenario layer, NOT per-vehicle A*)"},{"key":"fault_count","value":0,"unit":"count","definition":"注入的机器人故障次数","formula":"count(disruptions[type=robot_down])","source":"config/scenarios/*.json"},{"key":"replans","value":0,"unit":"count","definition":"扰动触发的改派/重规划次数","formula":"fault_count + count(disruptions[type=dock_blocked])","source":"config/scenarios/*.json"},{"key":"reassigned","value":0,"unit":"orders","definition":"因月台封锁需要改派的订单数","formula":"count(orders with from/to == blocked dock)","source":"runs/<id>/events.jsonl"},{"key":"layout_issues","value":0,"unit":"count","definition":"spec_layout 校验 FAIL 条数","formula":"len(spec_layout.validate().issues)","source":"out/spec_layout_report.json"},{"key":"warehouses","value":4,"unit":"count","definition":"仓库数","formula":"len(layout.warehouses)","source":"runs/<id>/layout.json"},{"key":"robots","value":21,"unit":"count","definition":"布局中的 AGV / HOME 数","formula":"sum(len(w.spawn.robots))","source":"runs/<id>/layout.json"},{"key":"fleet_size","value":21,"unit":"count","definition":"场景配置的车队规模","formula":"overrides.fleet.size or sum(fleet_spec.deployment.count)","source":"config/scenarios/*.json"},{"key":"plan_wall_clock_s","value":0.534,"unit":"s","definition":"本次场景层运行墙钟时间","formula":"time.time() delta","source":"runs/<id>/manifest.json"},{"key":"event_coverage","value":1.0,"unit":"ratio","definition":"主链订单执行覆盖率","formula":"assigned / events","source":"out/path_metrics.json + out/traffic_report.json (main chain, 21 orders)"}],"tick":[{"key":"orders_generated","value":83,"unit":"orders","definition":"Poisson arrivals","formula":"count(ORDER_ARRIVED)","source":"sim_engine measured"},{"key":"orders_completed","value":35,"unit":"orders","definition":"Delivered orders","formula":"count(TASK_COMPLETED)","source":"sim_engine measured"},{"key":"orders_lost","value":8,"unit":"orders","definition":"Orders dropped at queue cap","formula":"count(ORDER_LOST)","source":"sim_engine measured"},{"key":"throughput_orders_per_h","value":35.0,"unit":"orders/h","definition":"Measured throughput","formula":"orders_completed * 3600 / horizon_s","source":"sim_engine measured"},{"key":"on_time_rate","value":1.0,"unit":"ratio","definition":"On-time share","formula":"count(tardiness_s=0)/completed","source":"sim_engine measured"},{"key":"avg_tardiness_s","value":0.0,"unit":"s","definition":"Mean tardiness","formula":"mean(TASK_COMPLETED.tardiness_s)","source":"sim_engine measured"},{"key":"max_tardiness_s","value":0.0,"unit":"s","definition":"Max tardiness","formula":"max(TASK_COMPLETED.tardiness_s)","source":"sim_engine measured"},{"key":"distance_total_m","value":3224.082,"unit":"m","definition":"All three legs","formula":"sum(TASK_COMPLETED.legs_m)","source":